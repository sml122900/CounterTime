# ─────────────────────────────────────────────
# Unity 자동 생성물 (커밋하면 안 되는 것들)
# ─────────────────────────────────────────────
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# .meta 는 원본 에셋이 무시될 때만 무시 (원본이 살아있으면 .meta 는 반드시 커밋)
!/[Aa]ssets/**/*.meta

# Unity 가 재생성하는 IDE 프로젝트 파일 (커밋 불필요)
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE / 에디터
.vs/
.vscode/
.idea/
.consulo/

# Unity3D 크래시 로그
sysinfo.txt
crashlytics-build.properties

# 빌드 산출물
*.apk
*.aab
*.ipa
*.app

# OS
.DS_Store
Thumbs.db
desktop.ini

# Asset Store Tools
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# AI Toolkit — 패키지 캐시 (Unity 가 재생성)
/[Aa]ssets/AI Toolkit/
/[Aa]ssets/AI Toolkit.meta

# AI 에셋 생성 중간산물 (클립 guid 별 작업 폴더)
/GeneratedAssets/
