<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Harness</AssemblyName>
    <NoWarn>CS0618;CS0612;CS0414;CS0169;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity resolves this package into Library/PackageCache with a version hash in the
         folder name (…@<hash>) that can change across Unity/package-manager resolves.
         If this path is stale on your clone, find the current one with:
           find Library/PackageCache -iname nunit.framework.dll
         and update the HintPath below. -->
    <Reference Include="nunit.framework">
      <HintPath>..\..\Library\PackageCache\com.unity.ext.nunit@d8c07649098d\net40\unity-custom\nunit.framework.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- CounterTime.Core (pure C#) -->
    <Compile Include="..\..\Assets\_Project\Scripts\Core\**\*.cs" Exclude="..\..\Assets\_Project\Scripts\Core\Tests\**\*.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Core\Tests\*.cs" />

    <!-- CounterTime.Brain (pure C#, references Core) -->
    <Compile Include="..\..\Assets\_Project\Scripts\Brain\*.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Brain\Tests\*.cs" />

    <!-- CounterTime.Game subset that compiles against the UnityEngine shim below.
         See docs/overnight-2026-08-10.md §0 for which Game files can/can't be
         included and why (Canvas/TMP/Animator/coroutines can't be shimmed cheaply). -->
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Scenario\ScenarioLoader.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Match\ScenarioTurnChoices.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Match\ScriptedCommitSource.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Match\ScriptedAssembler.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Match\ScriptedReadResolver.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Match\MatchRunner.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Match\ResultNarrationTable.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Match\LiveAssembler.cs" />
    <!-- §H step 3.5a — save layer. Pure file I/O + JsonUtility, no Canvas/TMP/Animator,
         so it needs only the Application/JsonUtility.ToJson shim additions above. -->
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Save\SaveData.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Save\SaveSystem.cs" />
    <!-- §H 3.5b-로스터 tournament bracket — pure logic (no MonoBehaviour), needed by
         the 2026-08-13 overnight tournament-robustness pass (Overnight/OvernightRunner.cs). -->
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Meta\TournamentBracket.cs" />

    <Compile Include="..\..\Assets\_Project\Scripts\Game\Tests\ScenarioTurnChoicesTests.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Tests\ScriptedReadResolverTests.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Tests\ResultNarrationTableTests.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Tests\LiveAssemblerTests.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Game\Tests\SaveSystemTests.cs" />
    <!-- MatchRunnerHandActionTests.cs is deliberately NOT included — it needs
         GameObject/AddComponent/DestroyImmediate (Unity's real object model),
         which this shim does not attempt to fake. Run it in the Unity Test Runner. -->

    <Compile Include="UnityEngineShim.cs" />
    <Compile Include="Program.cs" />

    <!-- 2026-08-13 overnight data collection — new tooling code, no production files
         touched. See Overnight/OvernightRunner.cs's header comment. -->
    <Compile Include="Overnight\AutoAPlayer.cs" />
    <Compile Include="Overnight\MatchResult.cs" />
    <Compile Include="Overnight\MatchSimulator.cs" />
    <Compile Include="Overnight\OvernightRunner.cs" />
    <!-- 2026-08-13 v3: roster distinctiveness (task 1) + grip parity dynamics
         (task 3), separate entry point (see Program.cs' args check). See
         OvernightV3Runner.cs. -->
    <Compile Include="Overnight\OvernightV3Runner.cs" />
  </ItemGroup>

</Project>
