#!/bin/sh
set -eu

# 스탬프 대상은 경로가 아니라 파일 1행이 정한다.
# 1행이 스탬프 형식이면 관리 대상, 아니면 무시. 문서를 옮겨도 안 깨진다.
git diff --cached --name-only --diff-filter=ACM -- '*.md' | while IFS= read -r f; do
  [ -f "$f" ] || continue
  head -n 1 "$f" | tr -d '\r' \
    | grep -qE '^<!-- v[^ ]+ \| body:[0-9a-f]{7} -->$' || continue
  sh tools/stamp.sh "$f"
  git add "$f"
done
